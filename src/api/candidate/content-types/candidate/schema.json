{
  "kind": "collectionType",
  "collectionName": "candidates",
  "info": {
    "singularName": "candidate",
    "pluralName": "candidates",
    "displayName": "Candidate",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "company": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company.company"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "socialNetwork": {
      "type": "component",
      "repeatable": true,
      "component": "element.social-networks"
    },
    "source": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::source.source"
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "coverLetter": {
      "type": "text"
    },
    "address": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "birthDate": {
      "type": "date"
    },
    "skills": {
      "type": "text"
    },
    "salaryExpectation": {
      "type": "decimal"
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "male",
        "female",
        "non-binary",
        "gender-fluid",
        "genderqueer",
        "trans",
        "two-spirit",
        "not-specified"
      ]
    },
    "experience": {
      "displayName": "experience",
      "type": "component",
      "repeatable": true,
      "component": "candidate.experience"
    },
    "education": {
      "displayName": "edutacion",
      "type": "component",
      "repeatable": true,
      "component": "candidate.edutacion"
    },
    "tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tag-candidate.tag-candidate"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "demo": {
      "type": "boolean",
      "default": false
    },
    "referral": {
      "type": "boolean",
      "default": false
    },
    "referrals": {
      "displayName": "referrals",
      "type": "component",
      "repeatable": true,
      "component": "candidate.referrals"
    },
    "disqualify": {
      "type": "boolean",
      "default": false
    },
    "disqualifyReason": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::disqualify.disqualify"
    },
    "salaryPeriod": {
      "type": "enumeration",
      "enum": [
        "none",
        "hourly",
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "timezone": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "salaryCurrency": {
      "type": "string"
    },
    "ethnicity": {
      "type": "enumeration",
      "enum": [
        "american-indian",
        "white",
        "black",
        "east-asian",
        "hispanic ",
        "native-hawaiian",
        "more-races",
        "other "
      ]
    },
    "sexualOrientation": {
      "type": "enumeration",
      "enum": [
        "asexual",
        "bi",
        "gay-man",
        "gay-woman",
        "heterosexual",
        "pansexual",
        "queer",
        "not-specified",
        "other"
      ]
    },
    "religion": {
      "type": "enumeration",
      "enum": [
        "buddhist",
        "catholic",
        "christian",
        "hindu",
        "jewish",
        "muslim",
        "no-religion",
        "not-specified",
        "other"
      ]
    },
    "disability": {
      "type": "enumeration",
      "enum": [
        "yes",
        "no",
        "not-specified"
      ]
    },
    "veteranStatus": {
      "type": "enumeration",
      "enum": [
        "active-wartime",
        "armed-forces-service-medal-veteran",
        "disabled-veteran",
        "protected-veteran",
        "not-protected-veteran",
        "not-veteran",
        "recently-separated-veteran",
        "not-specified"
      ]
    },
    "pronouns": {
      "type": "enumeration",
      "enum": [
        "she",
        "he",
        "they",
        "no-pronouns",
        "other",
        "not-specified"
      ]
    }
  }
}

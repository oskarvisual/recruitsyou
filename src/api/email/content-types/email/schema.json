{
  "kind": "collectionType",
  "collectionName": "emails",
  "info": {
    "singularName": "email",
    "pluralName": "emails",
    "displayName": "Email",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "company": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company.company"
    },
    "from": {
      "type": "email"
    },
    "replyTo": {
      "type": "email"
    },
    "to": {
      "type": "email"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "richtext"
    },
    "event": {
      "type": "json"
    },
    "sent": {
      "type": "boolean",
      "default": false
    },
    "sentAt": {
      "type": "datetime"
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}

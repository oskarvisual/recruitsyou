{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "company": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company.company"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "sign",
        "file",
        "file-request"
      ],
      "default": "sign",
      "required": true
    },
    "job": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::job.job"
    },
    "candidate": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::candidate.candidate"
    },
    "code": {
      "type": "customField",
      "customField": "plugin::field-uuid.uuid",
      "required": true
    },
    "signers": {
      "displayName": "signers",
      "type": "component",
      "repeatable": true,
      "component": "document.signers"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "created",
        "sent",
        "pending",
        "done",
        "rejected"
      ],
      "default": "created"
    }
  }
}
